{
  "name": "dunlin",
  "version": "0.5.0",
  "private": true,
  "description": "Local knowledge search with source evidence, powered by Rust",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "dunlin": "./tools/rag/cli.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/index.d.ts",
    "dist/types.d.ts",
    "dist/mcp.d.ts",
    "dist/native.cjs",
    "dist/*.node",
    "dist/tools/*",
    "examples/*.mjs",
    "examples/manuals/*.md",
    "tools/rag/*.mjs",
    "tools/rag/authoring/*.mjs",
    "tools/rag/parsers/*",
    "docs/*.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses/*.txt"
  ],
  "napi": {
    "binaryName": "dunlin",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "npm run build:native && npm run build:js && npm run build:hannoy",
    "build:hannoy": "node scripts/build-hannoy.mjs",
    "build:native": "napi build --platform --output-dir dist --js native.cjs --dts native.d.cts --release --features node",
    "build:js": "tsc -p tsconfig.json",
    "test": "tsc -p tests/tsconfig.json && node --test tests/*.test.mjs",
    "test:package": "napi create-npm-dirs && node scripts/test-package.mjs",
    "bench": "node benches/keyword.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "cheerio": "1.2.0",
    "markdown-it": "15.0.3",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "docling.rs": "2.67.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@napi-rs/cli": "3.10.12",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  }
}
